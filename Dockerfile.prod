# Production Dockerfile - Uses Gunicorn
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    default-libmysqlclient-dev \
    pkg-config \
    curl \
    netcat \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends libldap2-dev libsasl2-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
COPY docker-site/requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copy project files
COPY docker-site/ .

# Copy wait scripts
COPY wait-for-db.py /app/wait-for-db.py
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Create static and media directories
RUN mkdir -p /app/static /app/media

# Collect static files
RUN python manage.py collectstatic --noinput || true

EXPOSE 8000

# Use entrypoint and Gunicorn for production

# Run as an unprivileged user instead of root.
#
# uid/gid 1000 deliberately matches the host account that owns the
# bind-mounted ./docker-site tree, so the container can read the source and
# write to the static/media volumes without chmod 777 anywhere.
# Apache keeps running as root in its own image because it binds :80/:443 and
# already drops privileges to www-data for its workers.
RUN groupadd -g 1000 app && useradd -u 1000 -g 1000 -m -s /usr/sbin/nologin app \
    && chown -R app:app /app /opt/venv
USER app

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120", "myproject.wsgi:application"]
