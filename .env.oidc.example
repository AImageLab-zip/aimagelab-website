# ============================================================================
# OIDC (OpenID Connect) Secret Configuration
# ============================================================================
# This file contains sensitive OIDC credentials that should NOT be committed to git.
# 
# Instructions:
# 1. Copy this file to .env.oidc (without .example)
# 2. Fill in your actual OIDC credentials
# 3. The .env file will automatically source this file
# 4. Make sure .env.oidc is in .gitignore
#
# IMPORTANT: Keep this file secure and never commit it to version control!

# OIDC Relying Party (RP) - Your application credentials
OIDC_RP_CLIENT_ID=your-client-id-here
OIDC_RP_CLIENT_SECRET=your-client-secret-here

# OIDC Provider (OP) Endpoints - URLs from your OIDC provider
OIDC_OP_AUTHORIZATION_ENDPOINT=https://your-oidc-provider.com/oauth2/authorize
OIDC_OP_TOKEN_ENDPOINT=https://your-oidc-provider.com/oauth2/token
OIDC_OP_USER_ENDPOINT=https://your-oidc-provider.com/oauth2/userinfo
OIDC_OP_JWKS_ENDPOINT=https://your-oidc-provider.com/oauth2/jwks

# Optional: OIDC Logout Endpoint
OIDC_OP_LOGOUT_ENDPOINT=https://your-oidc-provider.com/oauth2/logout

# OIDC Scopes - Information to request from the provider
# Common scopes: openid, email, profile
OIDC_RP_SCOPES=openid email profile

# Token signature algorithm (RS256, HS256, etc.)
OIDC_RP_SIGN_ALGO=RS256

# Default role for new users created via OIDC
# Options: professor, postdoc, phd, intern, alumni, past_member
OIDC_DEFAULT_USER_ROLE=phd

# Provider display name (shown on login button)
OIDC_PROVIDER_NAME=OIDC Provider
