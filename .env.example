# Environment variables for AImageLab Application

# Django Settings
DEBUG=1
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,aimagelab-app.ing.unimore.it
TZ=Europe/Rome

# Database Configuration
DB_HOST=mysql-db
DB_NAME=aimagelab_db
DB_USER=aimagelab_user
DB_PASSWORD=aimagelab_pass123
DB_PORT=3306
MYSQL_ROOT_PASSWORD=root_password_here

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Certbot Configuration
CERTBOT_EMAIL=admin@unimore.it
DOMAIN=aimagelab-app.ing.unimore.it

# Development Apache host port (change to run multiple stacks)
DEV_APACHE_PORT=8080

# ============================================================================
# OIDC (OpenID Connect) Configuration
# ============================================================================
# IMPORTANT: OIDC secrets are stored in a separate file (.env.oidc)
# 
# To configure OIDC:
# 1. Copy .env.oidc.example to .env.oidc
# 2. Fill in your actual OIDC credentials in .env.oidc
# 3. The .env.oidc file is automatically loaded (see docker-compose files)
# 4. Never commit .env.oidc to git (it's in .gitignore)
#
# Note: .env.oidc contains sensitive credentials and should be kept secure!
