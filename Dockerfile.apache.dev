FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    apache2 \
    curl \
    netcat \
    && rm -rf /var/lib/apt/lists/*

RUN a2enmod rewrite \
    && a2enmod proxy \
    && a2enmod proxy_http \
    && a2enmod headers \
    && a2enmod expires

COPY apache-dev.conf /etc/apache2/sites-available/aimagelab-dev.conf
RUN a2dissite 000-default \
    && a2ensite aimagelab-dev.conf

COPY ports.dev.conf /etc/apache2/ports.conf

RUN mkdir -p /var/www/html/static-dev

COPY docker-entrypoint-apache-dev.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint-apache-dev.sh

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/docker-entrypoint-apache-dev.sh"]
CMD ["apache2ctl", "-D", "FOREGROUND"]
